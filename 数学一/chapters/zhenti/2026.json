    "question": "设函数 \\(z=z(x,y)\\) 由方程 \\(x-az=\\mathrm{e}^{y+az}\\) 确定，其中 \\(a\\) 是非零常数，则（ ）",
    "options": [
      "A. \\(\\dfrac{\\partial z}{\\partial x}-\\dfrac{\\partial z}{\\partial y}=\\dfrac{1}{a}\\)",
      "B. \\(\\dfrac{\\partial z}{\\partial x}+\\dfrac{\\partial z}{\\partial y}=\\dfrac{1}{a}\\)",
      "C. \\(\\dfrac{\\partial z}{\\partial x}-\\dfrac{\\partial z}{\\partial y}=-\\dfrac{1}{a}\\)",
      "D. \\(\\dfrac{\\partial z}{\\partial x}+\\dfrac{\\partial z}{\\partial y}=-\\dfrac{1}{a}\\)"
    ],
    "testPoints": [
      "隐函数偏导数"
    ],
    "knowledgeIds": [],
    "knowledgePoints": [],
    "solution": [
      {
        "step": 1,
        "title": "方程两边对 $x$ 求偏导",
        "content": "把 \\(z\\) 视为 \\(x,y\\) 的函数。对 \\(x\\) 求偏导：<br>\\(1-a\\dfrac{\\partial z}{\\partial x}=\\mathrm{e}^{y+az}\\cdot a\\dfrac{\\partial z}{\\partial x}\\)，<br>故 \\(\\dfrac{\\partial z}{\\partial x}=\\dfrac{1}{a(1+\\mathrm{e}^{y+az})}\\)。"
      },
      {
        "step": 2,
        "title": "方程两边对 $y$ 求偏导",
        "content": "对 \\(y\\) 求偏导：<br>\\(-a\\dfrac{\\partial z}{\\partial y}=\\mathrm{e}^{y+az}\\Bigl(1+a\\dfrac{\\partial z}{\\partial y}\\Bigr)\\)，<br>故 \\(\\dfrac{\\partial z}{\\partial y}=-\\dfrac{\\mathrm{e}^{y+az}}{a(1+\\mathrm{e}^{y+az})}\\)。"
      },
      {
        "step": 3,
        "title": "作差得结论",
        "content": "两式相减：\\(\\dfrac{\\partial z}{\\partial x}-\\dfrac{\\partial z}{\\partial y}=\\dfrac{1+\\mathrm{e}^{y+az}}{a(1+\\mathrm{e}^{y+az})}=\\dfrac{1}{a}\\)，选 A。"
      }
    ],
    "answer": "A",
    "commonErrors": [],
    "frequency": 1,
    "tags": [
      "2026",
      "隐函数"
    ]
